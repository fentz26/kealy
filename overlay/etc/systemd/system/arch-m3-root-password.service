[Unit]
Description=Set a private root password on the local console
After=local-fs.target systemd-vconsole-setup.service
Before=getty@tty1.service
ConditionPathExists=!/etc/arch-m3-root-password-set

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/arch-m3/set-root-password
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
