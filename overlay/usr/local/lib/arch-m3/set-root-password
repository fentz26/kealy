#!/bin/sh
# First login uses standard systemd password provisioning, with no shared secret.
set -eu
marker=/etc/arch-m3-root-password-set
[ ! -e "$marker" ] || exit 0
/usr/bin/systemd-firstboot --force --prompt-root-password
hash=$(/usr/bin/getent shadow root | /usr/bin/cut -d: -f2)
case "$hash" in
    ''|'!'*|'*'*) echo 'A private root password is required. Reboot to retry.' >&2; exit 1 ;;
esac
/usr/bin/touch "$marker"
/usr/bin/chmod 600 "$marker"
