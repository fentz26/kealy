# Maintainer: Jos Dehaes <jos.dehaes@gmail.com>
# Maintainer: Matthias Kurz <m.kurz@irregular.at>

# Kealy: derived from asahi-alarm/PKGBUILDs m1n1 at
# 45cbc5719d8487026813b1877cb4e6ae420245f3. Builds AsahiLinux/m1n1 main at a
# pinned commit because M3 display-controller setup (m1n1 pull request #746)
# is newer than the v2.0.0 tag. The 1.9.9 patches are merged upstream.
pkgname=m1n1
pkgver=2.0.0.r77.gcf37927
pkgrel=1
pkgdesc='Asahi Linux bootloader'
_artwork_commit_id=80d14f8b6f485b310e305a84b4b806361518ddd1
_m1n1_commit_id=cf37927d6bf47c502136e7d2c9e61f946b0b8745
_artwork_srcname=artwork-${_artwork_commit_id}
_m1n1_srcname=m1n1-${_m1n1_commit_id##v}
arch=('aarch64')
url='http://asahilinux.org'
license=('MIT AND CC0-1.0 AND OFL-1.1-RFN AND Zlib AND (BSD-2-Clause OR GPL-2.0-or-later) AND (BSD-3-Clause OR GPL-2.0-or-later) AND (MIT OR Apache-2.0)')
makedepends=( imagemagick rust rust-src )
source=(
  "artwork-${_artwork_commit_id}.tar.gz::https://github.com/AsahiLinux/artwork/archive/${_artwork_commit_id}.tar.gz"
  "m1n1-${_m1n1_commit_id}.tar.gz::https://github.com/AsahiLinux/m1n1/archive/${_m1n1_commit_id}.tar.gz"
)
sha256sums=('f2b18744a38d1369a8e9e59acddd12551c5500435fbd9e709fe7a6b212a070ac'
            'SKIP') # pinned by full commit id

prepare() {
  rm -rf "${srcdir}/$_m1n1_srcname"/artwork
  cp -r "${srcdir}/$_artwork_srcname" "${srcdir}/$_m1n1_srcname"/artwork
}

build() {
  cd "${srcdir}/$_m1n1_srcname"

  make ARCH= RELEASE=1 BUILDSTD=1
}

package() {
  cd "${srcdir}"

  tgtdir="$pkgdir/usr/lib/asahi-boot"

  install -Dt "$tgtdir" -m644 "${_m1n1_srcname}/build/m1n1.bin"

  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" \
    "$srcdir/$_m1n1_srcname/LICENSE" \
    "$srcdir/$_m1n1_srcname"/3rdparty_licenses/LICENSE.*
}
