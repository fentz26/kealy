		};

		spmi@2e4714000 {
			compatible = "apple,t8122-spmi", "apple,t8103-spmi";
			reg = <0x02 0xe4714000 0x00 0x100>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;

			pmic@e {
				compatible = "apple,stowe-pmic", "apple,spmi-nvmem";
				reg = <0x0e 0x00>;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <0x01>;
					#size-cells = <0x01>;

					fault-shadow@867b {
						reg = <0x867b 0x10>;
					};

					socd@8b00 {
						reg = <0x8b00 0x400>;
					};

					boot-stage@f701 {
						reg = <0xf701 0x01>;
						phandle = <0x6b>;
					};

					boot-error-count@f702,0 {
						reg = <0xf702 0x01>;
						bits = <0x00 0x04>;
						phandle = <0x6c>;
					};

					panic-count@f702,4 {
						reg = <0xf702 0x01>;
						bits = <0x04 0x04>;
						phandle = <0x6d>;
					};

					boot-error-stage@f703 {
						reg = <0xf703 0x01>;
					};

					shutdown-flag@f70f,3 {
						reg = <0xf70f 0x01>;
						bits = <0x03 0x01>;
						phandle = <0x6a>;
					};

					pm-setting@f801 {
						reg = <0xf801 0x01>;
					};

