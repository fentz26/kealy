	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		stdout-path = "serial0";

		framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0x00 0x00 0x00 0x00>;
			power-domains = <0x4b 0xa4>;
			status = "disabled";
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		isp-heap@0 {
			compatible = "apple,asc-mem";
			reg = <0x00 0x00 0x00 0x00>;
			no-map;
			phandle = <0x45>;
		};
	};

	memory@800000000 {
		device_type = "memory";
		reg = <0x08 0x00 0x02 0x00>;
	};

	led-controller {
		compatible = "pwm-leds";

		led-0 {
			pwms = <0xa5 0x00 0x9c40>;
			label = "kbd_backlight";
			function = "kbd_backlight";
			color = <0x00>;
			max-brightness = <0xff>;
			default-state = "keep";
		};
	};

	sound {
		compatible = "apple,j314-macaudio", "apple,j504-macaudio", "apple,macaudio";
		model = "MacBook Pro J504";

		dai-link@0 {
			link-name = "Speakers";
			dai-tdm-idle-mode-0 = "zero";
			dai-tdm-idle-mode-3 = "zero";
			dai-tdm-slot-tx-idle-mask-0 = <0xf0f0f>;
			dai-tdm-slot-tx-idle-mask-3 = <0xf0f0f0>;

			cpu {
				sound-dai = <0xa6 0x00 0xa6 0x01>;
			};

			codec {
				sound-dai = <0xa7 0xa8 0xa9 0xaa 0xab 0xac>;
			};
		};

		dai-link@1 {
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <0xa6 0x02>;
			};

			codec {
				sound-dai = <0xad>;
			};
		};
	};
