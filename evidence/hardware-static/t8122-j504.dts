/dts-v1/;

/ {
	compatible = "apple,j504", "apple,t8122", "apple,arm-platform";
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Apple MacBook Pro (14-inch, M3, 2023)";

	aliases {
		atcphy0 = "/soc/phy@703000000";
		atcphy1 = "/soc/phy@b03000000";
		bluetooth0 = "/soc/pcie@580000000/pci@0,0/bluetooth@0,1";
		serial0 = "/soc/serial@2a1200000";
		wifi0 = "/soc/pcie@580000000/pci@0,0/wifi@0,0";
		usb4-0-acio = "/soc/cio@701ac0000";
		usb4-0-nhi = "/soc/cio@701ac0000/nhi@f00000";
		usb4-1-acio = "/soc/cio@b01ac0000";
		usb4-1-nhi = "/soc/cio@b01ac0000/nhi@f00000";
		usb4_0_rc = "/soc/cio@701ac0000";
		usb4_0_nhi = "/soc/cio@701ac0000/nhi@f00000";
		usb4_1_rc = "/soc/cio@b01ac0000";
		usb4_1_nhi = "/soc/cio@b01ac0000/nhi@f00000";
		nvram = "/soc/spi@2a1104000/flash@0/partitions/partition@700000";
		isp = "/soc/isp@2a4000000";
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x01>;
				};

				core1 {
					cpu = <0x02>;
				};

				core2 {
					cpu = <0x03>;
				};

				core3 {
					cpu = <0x04>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x05>;
				};

				core1 {
					cpu = <0x06>;
				};

				core2 {
					cpu = <0x07>;
				};

				core3 {
					cpu = <0x08>;
				};
			};
		};

		cpu@0 {
			compatible = "apple,sawtooth";
			device_type = "cpu";
			reg = <0x00 0x00>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x09>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			operating-points-v2 = <0x0a>;
			capacity-dmips-mhz = <0x324>;
			performance-domains = <0x0b>;
			phandle = <0x01>;
		};

		cpu@1 {
			compatible = "apple,sawtooth";
			device_type = "cpu";
			reg = <0x00 0x01>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x09>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			operating-points-v2 = <0x0a>;
			capacity-dmips-mhz = <0x324>;
			performance-domains = <0x0b>;
			phandle = <0x02>;
		};

		cpu@2 {
			compatible = "apple,sawtooth";
			device_type = "cpu";
			reg = <0x00 0x02>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x09>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			operating-points-v2 = <0x0a>;
			capacity-dmips-mhz = <0x324>;
			performance-domains = <0x0b>;
			phandle = <0x03>;
		};

		cpu@3 {
			compatible = "apple,sawtooth";
			device_type = "cpu";
			reg = <0x00 0x03>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x09>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			operating-points-v2 = <0x0a>;
			capacity-dmips-mhz = <0x324>;
			performance-domains = <0x0b>;
			phandle = <0x04>;
		};

		cpu@10100 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10100>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x0c>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x0d>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x0e>;
			phandle = <0x05>;
		};

		cpu@10101 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10101>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x0c>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x0d>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x0e>;
			phandle = <0x06>;
		};

		cpu@10102 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10102>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x0c>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x0d>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x0e>;
			phandle = <0x07>;
		};

		cpu@10103 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10103>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x0c>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x0d>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x0e>;
			phandle = <0x08>;
		};

		l2-cache-0 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x400000>;
			phandle = <0x09>;
		};

		l2-cache-1 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x1000000>;
			phandle = <0x0c>;
		};
	};

	opp-table-0 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x0a>;

		opp01 {
			opp-hz = <0x00 0x2c588a00>;
			opp-level = <0x01>;
			clock-latency-ns = <0x1e78>;
		};

		opp02 {
			opp-hz = <0x00 0x3e3a2d00>;
			opp-level = <0x02>;
			clock-latency-ns = <0x4bc8>;
		};

		opp03 {
			opp-hz = <0x00 0x57f9f900>;
			opp-level = <0x03>;
			clock-latency-ns = <0x60e0>;
		};

		opp04 {
			opp-hz = <0x00 0x77729d00>;
			opp-level = <0x04>;
			clock-latency-ns = <0xaa50>;
		};

		opp05 {
			opp-hz = <0x00 0x872eef00>;
			opp-level = <0x05>;
			clock-latency-ns = <0xc030>;
		};

		opp06 {
			opp-hz = <0x00 0x98597700>;
			opp-level = <0x06>;
			clock-latency-ns = <0xd098>;
		};

		opp07 {
			opp-hz = <0x00 0xa3cb2700>;
			opp-level = <0x07>;
			clock-latency-ns = <0xdde0>;
		};
	};

	opp-table-1 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x0d>;

		opp01 {
			opp-hz = <0x00 0x297c1e00>;
			opp-level = <0x01>;
			clock-latency-ns = <0x24b8>;
		};

		opp02 {
			opp-hz = <0x00 0x41169900>;
			opp-level = <0x02>;
			clock-latency-ns = <0x4d58>;
		};

		opp03 {
			opp-hz = <0x00 0x50d2eb00>;
			opp-level = <0x03>;
			clock-latency-ns = <0x5c94>;
		};

		opp04 {
			opp-hz = <0x00 0x5f210700>;
			opp-level = <0x04>;
			clock-latency-ns = <0x61a8>;
		};

		opp05 {
			opp-hz = <0x00 0x704b8f00>;
			opp-level = <0x05>;
			clock-latency-ns = <0x6e28>;
		};

		opp06 {
			opp-hz = <0x00 0x81761700>;
			opp-level = <0x06>;
			clock-latency-ns = <0x7e2c>;
		};

		opp07 {
			opp-hz = <0x00 0x907b4e00>;
			opp-level = <0x07>;
			clock-latency-ns = <0x8b10>;
		};

		opp08 {
			opp-hz = <0x00 0x9becfe00>;
			opp-level = <0x08>;
			clock-latency-ns = <0x9538>;
		};

		opp09 {
			opp-hz = <0x00 0xa75eae00>;
			opp-level = <0x09>;
			clock-latency-ns = <0x9b14>;
		};

		opp10 {
			opp-hz = <0x00 0xb2194300>;
			opp-level = <0x0a>;
			clock-latency-ns = <0xa2e4>;
		};

		opp11 {
			opp-hz = <0x00 0xbb65a200>;
			opp-level = <0x0b>;
			clock-latency-ns = <0xaab4>;
		};

		opp12 {
			opp-hz = <0x00 0xc3fae600>;
			opp-level = <0x0c>;
			clock-latency-ns = <0xafc8>;
		};

		opp13 {
			opp-hz = <0x00 0xcbd90f00>;
			opp-level = <0x0d>;
			clock-latency-ns = <0xbe3c>;
		};

		opp14 {
			opp-hz = <0x00 0xd3001d00>;
			opp-level = <0x0e>;
			clock-latency-ns = <0xd994>;
		};

		opp15 {
			opp-hz = <0x00 0xd8b8f500>;
			opp-level = <0x0f>;
			clock-latency-ns = <0xda5c>;
		};

		opp16 {
			opp-hz = <0x00 0xddbab200>;
			opp-level = <0x10>;
			clock-latency-ns = <0xda5c>;
		};

		opp17 {
			opp-hz = <0x00 0xe14e3900>;
			opp-level = <0x11>;
			clock-latency-ns = <0xdac0>;
		};

		opp18 {
			opp-hz = <0x00 0xe64ff600>;
			opp-level = <0x12>;
			clock-latency-ns = <0xdac0>;
		};

		opp19 {
			opp-hz = <0x00 0xec08ce00>;
			opp-level = <0x13>;
			clock-latency-ns = <0xf168>;
		};

		opp20 {
			opp-hz = <0x00 0xf1c1a600>;
			opp-level = <0x14>;
			clock-latency-ns = <0xf1cc>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x0f>;
		interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
		interrupts = <0x01 0x02 0x04 0x01 0x03 0x04 0x01 0x00 0x04 0x01 0x01 0x04>;
	};

	clock-ref {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "clkref";
		phandle = <0x10>;
	};

	clock-200m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xbebc200>;
		clock-output-names = "clk_200m";
		phandle = <0x27>;
	};

	clock-ref-nco {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-output-names = "nco_ref";
		clock-frequency = <0x35a4e900>;
		phandle = <0x46>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		nonposted-mmio;
		dma-ranges = <0x00 0x00 0x00 0x00 0xffffffff 0xffffc000>;

		cpufreq@210e20000 {
			compatible = "apple,t8122-cluster-cpufreq", "apple,t8112-cluster-cpufreq";
			reg = <0x02 0x10e20000 0x00 0x1000>;
			#performance-domain-cells = <0x00>;
			phandle = <0x0b>;
		};

		cpufreq@211e20000 {
			compatible = "apple,t8122-cluster-cpufreq", "apple,t8112-cluster-cpufreq";
			reg = <0x02 0x11e20000 0x00 0x1000>;
			#performance-domain-cells = <0x00>;
			phandle = <0x0e>;
		};

		i2c@2a1010000 {
			compatible = "apple,t8122-i2c", "apple,t8103-i2c";
			reg = <0x02 0xa1010000 0x00 0x4000>;
			clocks = <0x10>;
			interrupt-parent = <0x0f>;
			interrupts = <0x00 0x30c 0x04>;
			pinctrl-0 = <0x11>;
			pinctrl-names = "default";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			power-domains = <0x12>;
			status = "okay";

			usb-pd@38 {
				compatible = "apple,cd321x";
				reg = <0x38>;
				interrupt-parent = <0x13>;
				interrupts = <0x0b 0x08>;
				interrupt-names = "irq";

				connector {
					compatible = "usb-c-connector";
					power-role = "dual";
					data-role = "dual";
					label = "USB-C Left-back";

					ports {
						#address-cells = <0x01>;
						#size-cells = <0x00>;

						port@0 {
							reg = <0x00>;

							endpoint {
								remote-endpoint = <0x14>;
								phandle = <0x92>;
							};
						};

						port@1 {
							reg = <0x01>;

							endpoint {
								remote-endpoint = <0x15>;
								phandle = <0x94>;
							};
						};

						port@2 {
							reg = <0x02>;

							endpoint {
								remote-endpoint = <0x16>;
								phandle = <0x8d>;
							};
						};
					};
				};
			};

			usb-pd@3f {
				compatible = "apple,cd321x";
				reg = <0x3f>;
				interrupt-parent = <0x13>;
				interrupts = <0x0b 0x08>;
				interrupt-names = "irq";

				connector {
					compatible = "usb-c-connector";
					power-role = "dual";
					data-role = "dual";
					label = "USB-C Left-front";

					ports {
						#address-cells = <0x01>;
						#size-cells = <0x00>;

						port@0 {
							reg = <0x00>;

							endpoint {
								remote-endpoint = <0x17>;
								phandle = <0xa0>;
							};
						};

						port@1 {
							reg = <0x01>;

							endpoint {
								remote-endpoint = <0x18>;
								phandle = <0xa2>;
							};
						};

						port@2 {
							reg = <0x02>;

							endpoint {
								remote-endpoint = <0x19>;
								phandle = <0x9b>;
							};
						};
					};
				};
			};
		};

		i2c@2a1014000 {
			compatible = "apple,t8122-i2c", "apple,t8103-i2c";
			reg = <0x02 0xa1014000 0x00 0x4000>;
			clocks = <0x10>;
			interrupt-parent = <0x0f>;
			interrupts = <0x00 0x30d 0x04>;
			pinctrl-0 = <0x1a>;
			pinctrl-names = "default";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			power-domains = <0x1b>;
			status = "okay";

			codec@3a {
				compatible = "ti,sn012776", "ti,tas2764";
				reg = <0x3a>;
				shutdown-gpios = <0x13 0x0d 0x00>;
				#sound-dai-cells = <0x00>;
				sound-name-prefix = "Left Tweeter";
				interrupts-extended = <0x13 0x0c 0x08>;
				ti,imon-slot-no = <0x08>;
				ti,vmon-slot-no = <0x0a>;
				phandle = <0xa8>;
			};

			codec@38 {
				compatible = "ti,sn012776", "ti,tas2764";
				reg = <0x38>;
				shutdown-gpios = <0x13 0x0d 0x00>;
				#sound-dai-cells = <0x00>;
				sound-name-prefix = "Left Woofer 1";
				interrupts-extended = <0x13 0x0c 0x08>;
				ti,imon-slot-no = <0x00>;
				ti,vmon-slot-no = <0x02>;
				phandle = <0xa7>;
			};

			codec@39 {
				compatible = "ti,sn012776", "ti,tas2764";
				reg = <0x39>;
				shutdown-gpios = <0x13 0x0d 0x00>;
				#sound-dai-cells = <0x00>;
				sound-name-prefix = "Left Woofer 2";
				interrupts-extended = <0x13 0x0c 0x08>;
				ti,imon-slot-no = <0x10>;
				ti,vmon-slot-no = <0x12>;
				phandle = <0xa9>;
			};

			codec@4b {
				compatible = "cirrus,cs42l84";
				reg = <0x4b>;
				reset-gpios = <0x1c 0x11 0x00>;
				#sound-dai-cells = <0x00>;
				interrupts-extended = <0x13 0xad 0x08>;
				sound-name-prefix = "Jack";
				phandle = <0xad>;
			};
		};

		i2c@2a1018000 {
			compatible = "apple,t8122-i2c", "apple,t8103-i2c";
			reg = <0x02 0xa1018000 0x00 0x4000>;
			clocks = <0x10>;
			interrupt-parent = <0x0f>;
			interrupts = <0x00 0x30e 0x04>;
			pinctrl-0 = <0x1d>;
			pinctrl-names = "default";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			power-domains = <0x1e>;
			status = "okay";
		};

		i2c@2a101c000 {
			compatible = "apple,t8122-i2c", "apple,t8103-i2c";
			reg = <0x02 0xa101c000 0x00 0x4000>;
			clocks = <0x10>;
			interrupt-parent = <0x0f>;
			interrupts = <0x00 0x30f 0x04>;
			pinctrl-0 = <0x1f>;
			pinctrl-names = "default";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			power-domains = <0x20>;
			status = "okay";

			codec@3d {
				compatible = "ti,sn012776", "ti,tas2764";
				reg = <0x3d>;
				shutdown-gpios = <0x13 0x0d 0x00>;
				#sound-dai-cells = <0x00>;
				sound-name-prefix = "Right Tweeter";
				interrupts-extended = <0x13 0x0c 0x08>;
				ti,imon-slot-no = <0x0c>;
				ti,vmon-slot-no = <0x0e>;
				phandle = <0xab>;
			};

			codec@3b {
				compatible = "ti,sn012776", "ti,tas2764";
				reg = <0x3b>;
				shutdown-gpios = <0x13 0x0d 0x00>;
				#sound-dai-cells = <0x00>;
				sound-name-prefix = "Right Woofer 1";
				interrupts-extended = <0x13 0x0c 0x08>;
				ti,imon-slot-no = <0x04>;
				ti,vmon-slot-no = <0x06>;
				phandle = <0xaa>;
			};

			codec@3c {
				compatible = "ti,sn012776", "ti,tas2764";
				reg = <0x3c>;
				shutdown-gpios = <0x13 0x0d 0x00>;
				#sound-dai-cells = <0x00>;
				sound-name-prefix = "Right Woofer 2";
				interrupts-extended = <0x13 0x0c 0x08>;
				ti,imon-slot-no = <0x14>;
				ti,vmon-slot-no = <0x16>;
				phandle = <0xac>;
			};
		};

		i2c@2a1020000 {
			compatible = "apple,t8122-i2c", "apple,t8103-i2c";
			reg = <0x02 0xa1020000 0x00 0x4000>;
			clocks = <0x10>;
			interrupt-parent = <0x0f>;
			interrupts = <0x00 0x310 0x04>;
			pinctrl-0 = <0x21>;
			pinctrl-names = "default";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			power-domains = <0x22>;
			status = "disabled";
		};

		iommu@2a1004000 {
			compatible = "apple,t8122-dart", "apple,t8110-dart";
			reg = <0x02 0xa1004000 0x00 0x4000>;
			interrupt-parent = <0x0f>;
			interrupts = <0x00 0x318 0x04>;
			#iommu-cells = <0x01>;
			power-domains = <0x23>;
			phandle = <0x2b>;
		};

		avd@289080000 {
			compatible = "apple,t8122-avd";
			interrupt-parent = <0x0f>;
			interrupts = <0x00 0x2a7 0x04 0x00 0x2a8 0x04>;
			power-domains = <0x24>;
			resets = <0x24>;
			reg = <0x02 0x89080000 0x00 0x12000 0x02 0x89092000 0x00 0x12000 0x02 0x890a4000 0x00 0x4000 0x02 0x89100000 0x00 0x10000>;
			reg-names = "code", "sram", "mbox", "ctrl";
			iommus = <0x25 0x00>;
		};

		iommu@289010000 {
			compatible = "apple,t8122-dart", "apple,t8110-dart";
			reg = <0x02 0x89010000 0x00 0x4000>;
			#iommu-cells = <0x01>;
			interrupt-parent = <0x0f>;
			interrupts = <0x00 0x2ae 0x04>;
			power-domains = <0x24>;
			phandle = <0x25>;
		};

